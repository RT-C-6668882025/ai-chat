<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <LinearLayout style="@style/Widget.App.TopBar">

        <ImageView
            android:id="@+id/btn_changes_back"
            style="@style/Widget.App.IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <TextView
            style="@style/Widget.App.TopBar.Title"
            android:text="变更记录" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:padding="@dimen/space_m"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:text="括号指令与模型对变量、场景、人设、记忆做过的每一次全局修改都记在这里，可以逐条撤销。" />

    <TextView
        android:id="@+id/tv_changes_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="@dimen/space_xl"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textColor="@color/text_tertiary"
        android:text="还没有任何全局修改。\n试试在输入框里打一句（好感度+10）。"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_changes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_xl"
        android:scrollbars="none" />
</LinearLayout>
