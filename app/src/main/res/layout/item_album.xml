<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_l"
    android:layout_marginRight="@dimen/space_l"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <!-- 类型徽标 -->
        <FrameLayout
            android:layout_width="@dimen/avatar_m"
            android:layout_height="@dimen/avatar_m"
            android:background="@drawable/bg_badge_circle">

            <ImageView
                android:id="@+id/iv_album_icon"
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_album_kind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag"
                    android:textAppearance="@style/TextAppearance.App.Micro"
                    android:paddingLeft="@dimen/space_s"
                    android:paddingRight="@dimen/space_s"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingBottom="@dimen/space_xxs" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_album_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Micro" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_album_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.App.Headline" />

            <TextView
                android:id="@+id/tv_album_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <!-- 里程碑保存的当时那句话 -->
            <TextView
                android:id="@+id/tv_album_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@color/surface_variant"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.App.Inner"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
