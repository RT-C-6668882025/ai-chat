<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="1dp"
        android:paddingLeft="@dimen/space_s"
        android:paddingRight="@dimen/space_l">

        <TextView
            android:id="@+id/btn_mem_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="28sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="记忆"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btn_mem_summarize"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="立即总结"
            android:textSize="14sp"
            android:textColor="?attr/colorPrimary"
            android:paddingLeft="@dimen/space_m"
            android:paddingRight="@dimen/space_m" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_mem_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:alpha="0.6"
        android:paddingLeft="@dimen/space_l"
        android:paddingRight="@dimen/space_l"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_xs" />

    <TextView
        android:id="@+id/tv_mem_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="还没有记忆，多聊几句就有了"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:alpha="0.6"
        android:gravity="center"
        android:padding="@dimen/space_xxl"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_memory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l" />
</LinearLayout>
