<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/space_l"
    android:layout_marginRight="@dimen/space_l"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginBottom="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <!-- 头像 -->
        <TextView
            android:id="@+id/iv_char_avatar"
            android:layout_width="@dimen/avatar_m"
            android:layout_height="@dimen/avatar_m"
            android:gravity="center"
            android:background="@drawable/bg_badge_circle"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_m">

            <!-- 名字 + 伴侣标记 + 时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_char_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/tv_char_partner"
                    android:layout_width="@dimen/icon_s"
                    android:layout_height="@dimen/icon_s"
                    android:layout_marginStart="@dimen/space_xs"
                    android:src="@drawable/ic_star"
                    android:tint="@color/accent"
                    android:contentDescription="伴侣"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_char_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Micro" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_char_brief"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_char_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.App.Body.Secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 心情 + 连续陪伴天数 -->
            <LinearLayout
                android:id="@+id/ll_char_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_char_mood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_mood_pill"
                    android:textAppearance="@style/TextAppearance.App.Micro"
                    android:textColor="@color/on_accent_container"
                    android:paddingLeft="@dimen/space_s"
                    android:paddingRight="@dimen/space_s"
                    android:paddingTop="@dimen/space_xxs"
                    android:paddingBottom="@dimen/space_xxs" />

                <TextView
                    android:id="@+id/tv_char_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:drawableStart="@drawable/ic_flame"
                    android:drawableTint="@color/brand"
                    android:drawablePadding="@dimen/space_xxs"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.App.Micro"
                    android:textColor="@color/brand"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 好感度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pb_char_affection"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/affection_bar_height"
                    android:max="200"
                    android:progressDrawable="@drawable/progress_affection" />

                <TextView
                    android:id="@+id/tv_char_affection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.App.Micro"
                    android:textColor="@color/accent"
                    android:text="♡ 0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
