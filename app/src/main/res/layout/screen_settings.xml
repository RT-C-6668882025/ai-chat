<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="1dp"
        android:paddingLeft="@dimen/space_s"
        android:paddingRight="@dimen/space_l">

        <ImageView
            android:id="@+id/btn_set_back"
            style="@style/Widget.App.IconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <!-- 关于 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关于"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_set_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_update"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="检查更新" />

            <View
                style="@style/Widget.App.Divider"
                android:layout_marginTop="@dimen/space_l" />

            <!-- 外观 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="外观"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="主题"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:id="@+id/ll_theme_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_s">

                <TextView
                    android:id="@+id/btn_theme_system"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center"
                    android:text="跟随系统"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <TextView
                    android:id="@+id/btn_theme_light"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_s"
                    android:gravity="center"
                    android:text="暖阳"
                    android:textAppearance="@style/TextAppearance.App.Label" />

                <TextView
                    android:id="@+id/btn_theme_dark"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/space_s"
                    android:gravity="center"
                    android:text="星夜"
                    android:textAppearance="@style/TextAppearance.App.Label" />
            </LinearLayout>

            <View
                style="@style/Widget.App.Divider"
                android:layout_marginTop="@dimen/space_l" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="API"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="API 模式"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <Spinner
                android:id="@+id/sp_set_mode"
                android:layout_width="match_parent"
                android:layout_height="52dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="API Key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="地址（baseUrl）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_base"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:gravity="bottom">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    android:hint="主模型">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_model_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_pick_main"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:paddingLeft="@dimen/space_m"
                    android:paddingRight="@dimen/space_m"
                    android:text="选择" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:gravity="bottom">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="outline"
                    android:hint="记忆/判定模型（小模型）">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_set_model_memory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_set_pick_mem"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:paddingLeft="@dimen/space_m"
                    android:paddingRight="@dimen/space_m"
                    android:text="选择" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_test"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="测试连接" />

            <TextView
                android:id="@+id/tv_set_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="流式输出"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_stream"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:background="#22000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记忆"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:boxBackgroundMode="outline"
                android:hint="总结间隔（轮）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_mem_interval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="注入条数 Top-K">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_mem_topk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="每轮衰减率（0-1）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_mem_decay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="淡化阈值（低于则不注入）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_mem_fade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="上下文窗口（轮）">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:background="#22000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输出"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="变量系统"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_vars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="心声（inner）"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_inner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="多气泡"
                    android:textAppearance="@style/TextAppearance.App.Body" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI 判断括号指令"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="整行只有括号时，内容不当台词，交给模型判断是动作、场景、变量、人设还是要记住的事。每条括号指令多一次调用。关掉则括号按普通消息发送。"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_agent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="也判断 AI 回复里的括号"
                        android:textAppearance="@style/TextAppearance.App.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="每条带括号的回复都会多一次分类调用。AI 的括号多数就是动作，默认关闭。"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/sw_set_scan_replies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:boxBackgroundMode="outline"
                android:hint="最大气泡数">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_max_bubbles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:minHeight="48dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:background="#22000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="提示词模板"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                app:boxBackgroundMode="outline"
                android:hint="支持 {{char.name}} {{#if}} {{#each}}">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_set_template"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:gravity="top"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_ai_tpl"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="AI 帮我改模板" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_reset"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="恢复默认模板" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xs"
                android:background="#22000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_export"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="导出全部数据" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_import"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="导入数据（粘贴 JSON）" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_set_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_l"
        android:text="保存设置" />
</LinearLayout>
