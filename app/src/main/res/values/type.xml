<?xml version="1.0" encoding="utf-8"?>
<!-- 文字样式体系。布局中用 android:textAppearance 引用，不要再逐个写 textSize。 -->
<resources>

    <style name="TextAppearance.App" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 大标题：空态、庆祝卡 -->
    <style name="TextAppearance.App.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- 页面标题：顶栏 -->
    <style name="TextAppearance.App.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 区块标题：卡片头、角色名 -->
    <style name="TextAppearance.App.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 正文 -->
    <style name="TextAppearance.App.Body">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- 次级正文 -->
    <style name="TextAppearance.App.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 聊天气泡正文：行距更松，长文好读 -->
    <style name="TextAppearance.App.Bubble">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- 标签：按钮、chip -->
    <style name="TextAppearance.App.Label">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 说明文字 -->
    <style name="TextAppearance.App.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- 最小号：时间戳、计数 -->
    <style name="TextAppearance.App.Micro">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- 内心独白 / 动作描写：斜体弱化 -->
    <style name="TextAppearance.App.Inner">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
